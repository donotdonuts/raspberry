[Unit]
Description=Molly toilet cam labelling page
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
User=__USER__
WorkingDirectory=__APP__
ExecStart=__APP__/.venv/bin/python -m catcam.label_server
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
